# FLUXORA environment variables
# Copy to .env for local work. On Vercel/Netlify add the same names in the project's environment settings.
# Everything here is PUBLIC (VITE_ values are shipped to the browser). NEVER put a private key,
# seed phrase, API secret or deployer credential in this file or in any VITE_ variable.

# ---------------------------------------------------------------------------
# Wallet
# ---------------------------------------------------------------------------
# Optional. Turns on WalletConnect. Free project id: https://cloud.walletconnect.com
# After you attach your own domain, add that domain to the project's allowlist there.
# Free project id from https://cloud.reown.com (32 hex characters). Never invent one.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional. Public URL shown to wallets. Leave empty: the app uses the address of the page that served it,
# so it keeps working after you change domains.
VITE_APP_URL=

# ---------------------------------------------------------------------------
# Network / RPC (optional overrides; defaults come from the built-in network registry)
# ---------------------------------------------------------------------------
# Arc mainnet (chain id 5042)
VITE_ARC_RPC_URL=
VITE_ARC_EXPLORER_URL=
# Any other network by chain id, for example Base (8453):
# VITE_RPC_URL_8453=
# VITE_EXPLORER_URL_8453=

# ---------------------------------------------------------------------------
# Arc mainnet token addresses (from https://docs.arc.io/arc/references/contract-addresses)
# ---------------------------------------------------------------------------
VITE_ARC_EURC_ADDRESS=0xbEf5f6d51CB62b58e6A8f77868681825C6fe21c1
VITE_ARC_WETH_ADDRESS=0x128cC466B61f542da60c70e3aA11c10e19B84EDB
VITE_ARC_CIRBTC_ADDRESS=0x171A4217b86A807A64eB94757Db6849fb4bDbAA0

# ---------------------------------------------------------------------------
# FLUXORA contract addresses  <-- YOU fill these in AFTER you deploy (docs/DEPLOYMENT.md)
# ---------------------------------------------------------------------------
# Leave a value empty and that feature shows "Contract Not Deployed". Nothing is faked and no
# placeholder address is ever treated as a real contract.
# Tip: `bun run deploy:record` prints these lines for you from Foundry's broadcast output.
VITE_FLUXORA_TOKEN_ADDRESS=
VITE_FLUXORA_PAYMENTS_ADDRESS=
VITE_FLUXORA_STAKING_ADDRESS=
VITE_FLUXORA_GOVERNANCE_ADDRESS=
VITE_FLUXORA_TIMELOCK_ADDRESS=
# Optional: block number of the deployment (speeds up event lookups)
VITE_FLUXORA_DEPLOY_BLOCK=
